trigger1=1
scale=max(.01,(fvar(0)*fvar(0)+fvar(1)*fvar(1))**.5/240),1

[State 8602, Taut shimmer]
type=ChangeAnim
trigger1=time>=8
trigger1=anim=7100
value=7101

[State 8602, Final snap]
type=ChangeAnim
trigger1=(root,stateno)=4001
trigger1=(root,time)>=128
trigger1=anim!=7102
value=7102

[State 8602, Snap vanishes]
