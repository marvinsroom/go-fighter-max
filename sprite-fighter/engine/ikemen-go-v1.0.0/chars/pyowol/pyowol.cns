[State 8602, Hand to victim Y]
type=VarSet
trigger1=1
fvar(1)=(root,p2dist y)-fvar(3)-ifelse((root,stateno)=410,30,205-var(0)*35)

[State 8602, Aim filament]
type=AngleSet
trigger1=1
value=ifelse(fvar(0)<0,180+atan(fvar(1)/max(1,abs(fvar(0))))*57.29578,-atan(fvar(1)/max(1,abs(fvar(0))))*57.29578)

[State 8602, Reach victim]
