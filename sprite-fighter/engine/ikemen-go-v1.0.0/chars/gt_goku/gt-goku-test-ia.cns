;===============================================================================
; INTELIGENCIA ARTIFICIAL:
;===============================================================================
[Statedef -2]
[State -2, Test no KO]
type=AssertSpecial
trigger1=!ishelper
flag=globalnoko
[State -2, Clear fixture helpers]
type=DestroySelf
triggerall=ishelper
trigger1=root,stateno=99000
ignorehitpause=1

[State -2, Preserve illustrated form through borrowed hurt states]
type=ChangeAnim
triggerall=!ishelper && anim>=0
trigger1=anim<950000
trigger2=anim>=1000000 && floor(anim/1000000)!=map(goku.bank)+1
value=(anim%1000000)+(map(goku.bank)+1)*1000000
elem=AnimElemNo(0)
ignorehitpause=1


[State 0, Run]
type = ChangeState
triggerall = ailevel > 0 && roundstate = 2
triggerall = ctrl
triggerall = p2bodydist x > 100
trigger1 = random < (ailevel * 100)/2
value = 60

[State 0, Run Atras]
type = ChangeState
triggerall = backedgebodydist > 50
triggerall = ailevel > 0 && roundstate = 2
triggerall = ctrl
triggerall = p2bodydist x < 100 && p2movetype = A
trigger1 = random < (ailevel * 100)/4
value = 70

[State 0, Guard]
type = ChangeState
triggerall = ailevel > 0 && roundstate = 2
triggerall = ctrl
triggerall = (p2bodydist x < 50 && p2movetype = A) || (enemy,numproj > 0)
trigger1 = random < (ailevel * 100)/2
value = ifelse(statetype = A,132,130)

[State 0, Power Charge]
type = ChangeState
triggerall = power < 3000
triggerall = ailevel > 0
triggerall = ctrl
triggerall = p2bodydist x > 100
trigger1 = random < (ailevel * 100)/4
value = 500

[State 0, Power Charge End]
type = ChangeState
triggerall = time >= 12
triggerall = stateno = 500
triggerall = ailevel > 0
trigger1 = (p2bodydist x < 50) || (enemy,numproj > 0)
trigger2 = power = 3000
value = 501

[State 0, SS1 Activar]
type = ChangeState
triggerall = statetype != A
triggerall = power >= 500
triggerall = var(2) = 0
Triggerall = var(3) = 0
