; HIT_LIEDEAD
[Statedef 5150]
type    = L
movetype= H
physics = N
sprpriority = ifelse((prevstateno=4150),9,-3)

[State 5151, Assert]
type = AssertSpecial
trigger1=prevstateno=5151&&anim=5151
trigger1=animelemtime(1)<=250
flag = roundnotover
flag2= timerfreeze
ignorehitpause=1

[State 5150, 1] ;Normal anim
type = ChangeAnim
triggerall = var(13)=0
triggerall = Time = 0
triggerall = SelfAnimExist(5140)
trigger1 = (anim != [5111,5119]) && (anim != [5171,5179])
trigger2 = !SelfAnimExist(5140 + (anim % 10))
value = 5140

[State 5150, 3] ;Hit up type anim
type = ChangeAnim
triggerall=var(13)=0
trigger1 = Time = 0
trigger1 = (anim = [5111,5119]) || (anim = [5171,5179])
trigger1 = SelfAnimExist(5140 + (anim % 10))
value = 5140 + (anim % 10)

[State 5150, 4] ;Match over anim
type = ChangeAnim
persistent = 0
triggerall=var(13)=0
trigger1 = MatchOver = 1
trigger1 = Anim = [5140,5149]
trigger1 = SelfAnimExist(anim+10)
value = anim+10

[State 5150, 5] ;Switch to 5110 if liedead anim does not exist
type = ChangeAnim
triggerall=var(13)=0
trigger1 = Time = 0
trigger1 = Anim != [5140,5159]
trigger1 = Anim != [5110,5119]
value = 5110


[State 5150, 1] ;SUPER SHREDDER DEATH anim
type = ChangeAnim
triggerall = prevstateno!=4150&& numhelper(3301)>0
trigger1 = Time=0
trigger1 = MatchOver = 1
value = 33170

[State 5150, EnvShake]
type = EnvShake
trigger1 = Anim = 33170 && AnimElemTime(3) =1
trigger2 = Anim = 33170 && AnimElemTime(5) =1
time = 20
freq = 180

[State 5150, PlaySnd]
type = PlaySnd
trigger1 = Anim = 33170 && AnimElemTime(3) =1
trigger2 = Anim = 33170 && AnimElemTime(5) =1
value=s3320,0
channel=2

[State 5150, PlaySnd]
type = PlaySnd
trigger1 = Anim = 33170 && AnimElemTime(5) =1
trigger2 = Anim = 5150 && AnimElem=3
value=s1100,3
volumescale=100
channel=3
persistent=0

[State 5150, 1] ;SUPER SHREDDER DEATH anim
type = ChangeAnim
trigger1 = prevstateno = 4150 && Time = 0
trigger2 = Anim=33170 && AnimElemtime(5) =3
trigger2 = MatchOver = 1
value = 5150
elem=3

[State 5150, 6] ;Friction
type = VelMul
trigger1 = 1
x = 0.85

[State 5150, 7] ;Friction
type = VelSet
trigger1 = Vel x < .05
persistent = 0
x = 0

[State 5150, 8]
type = NotHitBy
trigger1 = 1
value = SCA
time = 1

[State 5150, NO DEATH CRY]
type = AssertSpecial
triggerall = prevstateno = 4150 && Anim = 5150
trigger1=1
ignorehitpause=1
flag = nokosnd

[State 5150, DEATH CRY]
type= Playsnd
triggerall = prevstateno != 4150
trigger1 = Anim=5150 && AnimElemtime(1)=5
value= s11, 1
volumescale=100
persistent=0
