;=============== DAMAGE DAMPENER =====================
[state -2,Dampener:_Hit#]
type=varadd
trigger1=movehit=1
trigger1=!(hitdefattr=SCA,AT)
fvar(0)=1.0

[State -2,Dampener:_Reset_Hit#]
type=varset
trigger1=fvar(0)
trigger1=numenemy
trigger1=!(enemynear,movetype=H)&&!(enemynear,anim=5300)
fvar(0)=0.0
ignorehitpause=1

[State -2,Dampener:_Initialize]
type=varset
trigger1=stateno!=[3000,3999]
fvar(1)=ifelse((fvar(0)<=1.0),1.0,(0.9**fvar(0)))
ignorehitpause=1

[State -2,Dampener:_Super]
type=varset
trigger1=stateno=[3000,3999]
fvar(1)=ifelse((fvar(0)<=var(15)),1.0,0.65)
;fvar(1)=ifelse(fvar(0)<=var(15),1.0,0.65)+(0.25*var(25))
ignorehitpause=1

[State -2,Dampener:_Zero]
type=varset
trigger1=fvar(1)<0
fvar(1)=0.0
ignorehitpause=1
[State -2,Dampener:_Activate]
type=attackmulset
trigger1=1
value=fvar(1)
ignorehitpause=1

