; Constants and state file.
; There are comments scattered through this file, so you may like to
; take a look if would like to learn more about the cns.

[Data]
life  = 1000
power = 3000
attack = 100
defence =100
fall.defence_up =50
liedown.time = 60
airjuggle = 15
sparkno = 2
guard.sparkno = s8000
KO.echo = 0
volumescale=100
IntPersistIndex  = 52
FloatPersistIndex= 38  

[Size]
xscale = 1.33;1.35
yscale = 1.16
ground.back =30
ground.front=30
air.back = 12
air.front= 12
height = 60
attack.dist = 160
proj.attack.dist = 90
proj.doscale = 1  
head.pos=-10,-90
mid.pos = -5,-60
shadowoffset = 0
draw.offset = 0,0

[Velocity]
walk.fwd  = 3
walk.back = -3
run.fwd  = 7,0
run.back =-5,-5
jump.neu = 0,-9;.5	
jump.back=-4,-9
jump.fwd = 4,-9
runjump.back = -2.55,-8.1
runjump.fwd = 4,-8.1
airjump.neu = 0,-8.1
airjump.back= -3.55
airjump.fwd = 3.5

[Movement]
airjump.num = 0		;Number of air jumps allowed (opt)
airjump.height= 35	;Minimum distance from ground before you can air jump (opt)
yaccel = .5   ;Vertical acceleration
stand.friction  = .85	;Friction coefficient when standing
crouch.friction = .82	;Friction coefficient when crouching

;Default language victory quotes **MUGEN 1.0**
;The default language victory quotes must be implemented in English.
[Quotes]
; Up to 100 victory quotes can be specified per language (victory0 - victory99)
victory1 = "...The Phoenix has risen... My destiny is true!"
victory2 = "Had I not known that you were dead already, I would have mourned your loss of life."
victory3 = "The Foot have existed for centuries, and they will live on for centuries more, with me at their helm."
victory4 = "BAH! Weapons are for children! I have my armor, it suffices!"
victory5 = "The only word that matters is mine! My word is law!"
victory6 = "I am Oroku Saki, Ninja Master of the Foot Clan."
victory7 = "Bow before my magnificence and might, and I may spare you when my time arrives. But only if it pleases me to do so!"
victory8 = "Who I am and what I do is none of your concern! Merely prepare yourself for the inevitability of my reign!"
victory9 = "I have spoken! Be gone with you!"
victory10= "FOOLS! Had there been more of you, you might have overpowered me! Your fate is sealed now!"
victory11= "My onslaught has only just begun!"
victory12= "Watch your backs, Gaijin!"
victory13= "Tonight I dine on turtle soup."
victory14= "To me, Foot! Tonight we take over this town!"
victory15= "Oh, You nuclear-age numbskulls! You really thought you could challenge The Shredder?"
victory16= "My might is too great for you wretched, bumbling, punks!"
victory17= "Fools! You may have delayed The Shredder, but that is the last thing you will ever do!"
victory18= "Crawl home and lick your wounds, I will await your challenge when your heart has filled with revenge."
victory19= "Go ahead. Attack me if you will. When it is over, you will call me Master!"
victory20= "All living things die in the end. Your honour was to be slayed by me."
victory21= "You forget who you talk to you wimpering worm! I am the Shredder!"
victory22= "Blast that grotesque ganglion! Im stuck out of the technodrome AGAIN!"
victory23= "KRANG! DEPLOY THE MOUSERS!"
victory24= "Come face your DOOM!"
victory25= "Back to the fishbowl, Turtle!"



;---------------------------------------------------------------------------
;   VARIABLES ( VAR / VARS INDEX)
; var(0)     =     EX GROUND WAVE Angeldraw Timer
; var(1)     =     GROUND WAVE anim + velocity Recognition
; var(2)     =     SHURIKEN    anim + velocity Recognition
; var(4)     =     Intro Poses 
; var(5)     =     Intro + Win Poses randomization
; var(6)     =     Guard Push 
; var(7)     =     ENEMY BOUND / WALL HIT Target, ID
; var(8)     =     ENEMY BOUND / WALL HIT Target, ID 
; var(9)     =     ENEMY BOUND / FLOOR HIT Target, ID
; var(10)    =     ENEMY BOUND / FLOOR HIT Target, ID 
; var(11)    =     WALL BOUNCE variable recognition
; var(12)    =     FLOOR BOUNCE variable recognition
; var(13)    =     SUPER SHREDDER MODE recognition

; var(15)    =     DAMAGE SCALING / SUPER RECOGNITION
; var(17)    =     FOOT SOLDIER DELAY

; var(18)    =     Super/Special Restriction during RETROMUTAGEN 1st Opponent
; var(19)    =     Super/Special Restriction during RETROMUTAGEN 2nd Opponent
; var(20)    =     EX ENERGY BIND Shredder's Hold animation synch
; var(21)    =     DIVE KICK SHURIKEN DELAY HELPER generate 

; var(22)    =     Training Mode detection
; var(23)    =     False Death State detection initiate
; var(24)    =     Prevents Shredder from re-entering False Death 
; var(25)    =     AURA CRUSHER velocity Recognition
; var(26)    =     p2dist x
; var(27)    =     FOOT SOLDIER TYPE Recognition
; var(28)    =     P2 Opponent ID
; var(29)    =     P4 Opponent ID
 
; var(30)    =     SUPER KO FINISH
; var(38)    =     disallow throws on GETUP FROM LIEDOWN
; var(39)    =     SUPER SHREDDER IMMOvABLE POSSET Variable
; var(40)    =     SUPER SHREDDER IMMOvABLE POSSET Variable
; var(41)    =     SUPER SHREDDER GetHitVar Recognition 
; var(52)    =     Round OVer Recognition
; var(53)    =     Round Win Recognition
; var(54)    =     Round Lose Recognition



; RETROMUTAGEN RAY Helper Variable Definitions
; Var(0)    =     Index of character animation (negative value indicates flying character)
;                                        
; Var(3)    =     Time transformed left 1st Opponent
; var(14)   =     Time transformed left Additional Opponent


; FVAR(0)  = DAMAGE SCALING  
; FVAR(1)  = DAMAGE SCALING
; FVAR(21) = CORNERPUSH CODING
; FVAR(29) = SUPER SHREDDER DAMAGE 
; FVAR(38) = SPLINTER HELPER
; FVAR(39) = APRIL O'NEIL HELPER

;---------------------------------------------------------------------------
; Stand
[Statedef 0]
type = S
physics = S
sprpriority = 0

[State 0, 1]
type = NotHitBy
trigger1 =anim=180
value = SCA
time = 1
ignorehitpuase=1

[State 0, SURRENDER TURTLES OR YOU WILL NEVER SEE YOUR SENSEI AGAIN]
type = PlaySnd
trigger1 =anim=180&&Time=10
value = s192,20
persistent=0
channel=8

[State 0, 4]
type = ChangeAnim
trigger1 = Anim=180&&Time>150
value = 0

[State 0, RemoveExplod]; Super BG
type = Removeexplod 
trigger1=1
ID  =8507

[State 0, HELPER]
type=Helper
triggerall=!Time
trigger1=prevstateno=700
trigger2=prevstateno=710
name="EVADE DELAY"
postype=P1
pos=0,0
stateno=715
id     =715
ownpal=1
persistent=0
ignorehitpause=1

[State 0, Width]
Type= Width
triggerall=Numhelper(3301)<0
trigger1=1
edge=8,0

[State 3301, Width]
type = width
triggerall=numhelper(3301)>0
trigger1 = 1
edge = 30,30
ignorehitpause = 1


[State 0, RemoveExplod]; Super BG
type = Removeexplod 
trigger1 = time=0
ID = 8506

[State 0, RemoveExplod]; Super BG
type = Removeexplod 
trigger1 = time=0
ID = 8508

[State 0, 1]
type = ChangeAnim
triggerall=prevstateno!=197
trigger1 = var(13)=0&&Anim != 0 && Anim != 5   || var(13)!=0&&Anim!=3301 && Anim!=3302
trigger2 = var(13)=0&&Anim  = 5 && AnimTime = 0 || var(13)!=0&&Anim=3302&& Animtime=0 ;Turn anim over
value = ifelse((var(13)=0),0,3301)

[State 0, 1]
type = ChangeAnim
triggerall=prevstateno=197
trigger1 = fvar(38)=1&&!Time
value=180
elem=4
persistent=0

[State 0, 2]
type = VelSet
trigger1 =Time=0
y = 0

[State 0, 3] ;Stop moving if low velocity or 4 ticks pass
type = VelSet
trigger1 = abs(vel x) < 2
trigger2 = Time = 4
x = 0

[State 0, 4] ;Are you dead?
type = ChangeState
trigger1 = !alive
value = 5050

;---------------------------------------------------------------------------
; Stand to Crouch
[Statedef 10]
type    = C
physics = C
anim = ifelse((var(13)>0||numhelper(3301)>0),3301,10)

[State 10, 0]
type = ChangeState
triggerall=(var(13)>0||numhelper(3301)>0)
trigger1 =!Time
value = 0
ctrl = 1

[State 10, 1]
type = VelMul
trigger1 = Time = 0
x = .75


[State 10, 2] ;Stop moving if low velocity
type = VelSet
trigger1 = abs(vel x) < Const(movement.crouch.friction.threshold)
x = 0

[State 10, 3]
type = ChangeState
trigger1 = AnimTime = 0
value = 11

;---------------------------------------------------------------------------
; Crouching
[Statedef 11]
type    = C
physics = C
anim = ifelse((var(13)>0||numhelper(3301)>0),3301,ifelse((prevstateno=450),9,11))
sprpriority = 0

[State 11, 0]
type = ChangeState
triggerall=(var(13)>0||numhelper(3301)>0)
trigger1 =!Time
value = 0
ctrl = 1

[State 11, 1] ;Change from turning animation
type = ChangeAnim
trigger1 = Anim = 6 && AnimTime = 0
value = ifelse((var(13)=0),11,3301)


[State 11, 2] ;Stop moving if low velocity
type = VelSet
trigger1 = abs(vel x) < Const(movement.crouch.friction.threshold)
x = 0

;---------------------------------------------------------------------------
; Crouch to Stand
[Statedef 12]
type    = S
physics = S
anim = ifelse((var(13)>0||numhelper(3301)>0),3301,12)


[State 12, 1]
type = ChangeState
trigger1 = AnimTime = 0
value = 0
ignorehitpause = 1
;------------
; Walk
[Statedef 20]
type    = S
physics = S
sprpriority = ifelse((var(13)>0||numhelper(3301)>0),-1,0)

[State 20, RemoveExplod]; Super BG
type = Removeexplod 
trigger1=1
ID  =8507
[State 20, Width]
Type= Width
triggerall=Numhelper(3301)<0
trigger1=1
edge=8,0

[State 3301, Width]
type = width
triggerall=numhelper(3301)>0
trigger1 = 1
edge = 30,30
ignorehitpause = 1

[State 20, 1]
type = ChangeAnim
triggerall=command = "holdfwd"
trigger1 = var(13)=0&&command = "holdfwd"&&Anim != 20 && Anim != 5 ||var(13)!=0&&Anim!=3303 &&Anim!=3302
trigger2 = var(13)=0&&command = "holdfwd"&&Anim = 5 && AnimTime = 0||var(13)!=0&&Anim=3302&& Animtime=0
value = ifelse((var(13)=0),20,3303)

[State 20, 2]
type = ChangeAnim
triggerall =command = "holdback"
trigger1 = var(13)=0&&Anim != 21 && Anim != 5 ||var(13)!=0&&Anim!=3304 &&Anim!=3302
trigger2 = var(13)=0&&Anim = 5 && AnimTime = 0||var(13)!=0&&Anim=3302&& Animtime=0
value = ifelse((var(13)=0),21,3304)

[State 20, 1]
type = VelSet
triggerall=1
trigger1 = var(13)=0&&command = "holdfwd"
trigger2 = var(13)>0&&command = "holdfwd" || var(13)>0&&command!= "holdfwd" &&animelem<=11
x = const(velocity.walk.fwd.x)

[State 20, 2]
type = VelSet
triggerall=1
trigger1 = var(13)=0&&command = "holdback"
trigger2 = var(13)>0&&command = "holdback" || var(13)>0&&command!= "holdback" &&animelem<=11
x = const(velocity.walk.back.x)

[State 20, Forward - Enemy Corner]; Prevents going over opponent when at edge
type = VelSet
triggerall=var(13)>0
trigger1 = FrontEdgeBodyDist <= enemyNear, Const(size.ground.front) + Const(size.ground.front)
trigger1 = enemyNear, BackEdgeBodyDist <= 0
trigger1 = anim=3303
x = 0

[State 20, Pause]
type = VelSet
trigger1 = Anim = 3303 && (AnimElemNo(0) = [1, 2])
trigger2 = Anim = 3303 && (AnimElemNo(0) = [6, 7])
trigger3 = Anim = 3303 && (AnimElemNo(0) = 11)
trigger4 = Anim = 3304 && (AnimElemNo(0) = [1, 2])
trigger5 = Anim = 3304 && (AnimElemNo(0) = [6, 7])
trigger6 = Anim = 3304 && (AnimElemNo(0) = 11)
x = 0

[State 20, EnvShake]
type = EnvShake
trigger1 = Anim = 3303 && AnimElemTime(6) =1
trigger2 = Anim = 3303 && AnimElemTime(11)=1
trigger3 = Anim = 3304 && AnimElemTime(6) =1
trigger4 = Anim = 3304 && AnimElemTime(11)=1
time = 6
freq = 180

[State 20, EnvShake]
type = PlaySnd
trigger1 = Anim = 3303 && AnimElemTime(6) =1
trigger2 = Anim = 3303 && AnimElemTime(11)=1
trigger3 = Anim = 3304 && AnimElemTime(6) =1
trigger4 = Anim = 3304 && AnimElemTime(11)=1
value=s3320,0
;---------------------------------------------------------------------------
; Jump Start
[Statedef 40]
type    = S
physics = S
anim = ifelse((var(13)>0||var(13)>=0&&numhelper(3301)>0),3301,40)
ctrl = 0
sprpriority = 1
facep2=1

[State 40, 1]
type = VarSet
trigger1 = Time = 0
sysvar(1) = 0

[State 40, 2]
type = VarSet
trigger1 = command = "holdfwd"
sysvar(1) = 1

[State 40, 3]
type = VarSet
trigger1 = command = "holdback"
sysvar(1) = -1

[State 40, 4]
type = VelSet
trigger1 = AnimTime = 0
x = ifelse(sysvar(1)=0, const(velocity.jump.neu.x), ifelse(sysvar(1)=1, const(velocity.jump.fwd.x), const(velocity.jump.back.x)))
y = const(velocity.jump.y)

[State 40, 5]
type = VelSet
triggerall=anim!=3301
trigger1 = AnimTime = 0
trigger1 = prevstateno = 100 ;RUN_FWD
trigger1 = sysvar(1) = 1
x = const(velocity.runjump.fwd.x)

[State 40, Explod]; GROUND HIT DUST
type = explod 
triggerall=anim!=3301
trigger1 =animtime=0
anim=8100
ID  =8100
pos = 0,5
postype = P1
facing = 1
vfacing = 1
bindtime = 1
removetime = 10
supermovetime = 999999
pausemovetime = 999999
scale = .55,.55
sprpriority =-1
ontop =0
ownpal = 1
removeongethit = 1
shadow = 0,0, 0

[State 40, 6]
type = ChangeState
triggerall=Anim!=3301
trigger1 = AnimTime = 0
value = 50
ctrl = 1

[State 40, 6]
type = ChangeState
triggerall=anim=3301
trigger1 =!Time
value = 0
ctrl = 1

