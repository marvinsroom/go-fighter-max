; RUN_FWD
[Statedef 100]
type    = S
physics = S
anim = 110
sprpriority = 1
ctrl=0

[State 100,PlaySnd]
type = PlaySnd
trigger1 =Time= 0
value = 100, 0
loop = 1
channel=0

[State 100, Explod];Dust Culf
type = explod 
trigger1 =anim=110&&animelemtime(1)=1
anim=8120
ID = 8120
pos = 0,-10
velocity=-1,0
postype = P1
facing  = 1
vfacing = 1
removetime =25
supermovetime = 999999
pausemovetime = 999999
scale = 1.8,1
sprpriority =9
ontop = 1
ownpal= 1 
removeongethit =1
ignorehitpause=1
shadow =0,0, 0
persistent=0

[State 100, 1]
type = VelSet
trigger1 = 1
x = const(velocity.run.fwd.x)

[State 100, 2] ;Prevent run from canceling into walk
type = AssertSpecial
trigger1 = 1
flag = NoWalk

[State 100, 3] ;Prevent from turning
type = AssertSpecial
trigger1 = 1
flag = NoAutoTurn

[State 100, Jump]
type= changestate
trigger1= command="holdfwd" && command="holdup"
value= 40

[State 100,SuperJump]
type= changestate
trigger1= command = "super jump"
value= 55

[State 100, 4]
type = ChangeState
trigger1 = !AILevel
trigger1 = command != "holdfwd"
trigger2 = AILevel
trigger2 = p2bodydist x <= 100
value =101

[State 100, CtrlSet]
type = CtrlSet
trigger1 = time = 0
value = 0

[State -3, STOP Run Sound]
type = StopSnd
triggerall=1
trigger1 = !AILevel
trigger1 = command!= "holdfwd"
trigger2 = command!= "holdfwd"&&Command = "holddown"
trigger2 = !AILevel
trigger3 = command!= "holdfwd"&&Command = "holdback"
trigger3 = !AILevel
trigger4 = AILevel
trigger4 = p2bodydist x <= 50
ignorehitpause = 1
persistent=0
channel=0
