statetype = L
movetype = H
physics = N

[State 0, EnvShake]
type = EnvShake
TriggerAll = Time >= 10
trigger1 = Time%5=0
time = 10-(Time*.15)
ampl = -3

[State 0, HitFallSet]
type = HitFallSet
TriggerAll = Time >= 10 && Time <= 45
trigger1 = 1
value = 0

