; zoom
[Statedef 790]
anim = 9999
sprpriority = 1

[State 0, ScreenBound]
type = ScreenBound
trigger1 = 1
value = 1
movecamera = 1,1
ignorehitpause = 1

[State 0, BindToRoot]
type = BindToparent
triggerall = ishelper(795)
trigger1 =  root,stateno=3000
time = 1
facing = 1
pos = 0,0

[State 0, pos x]
type = Null
triggerall = ishelper(795)
trigger1 = time=0
trigger1 = fvar(10):=0
trigger2 =root,anim=3006&& root,time > 250 && root,time < 260
trigger2 = fvar(10):=fvar(10)+cond(facing = 1,2,-2);fvar(10),-0)
trigger3 = root,anim=3011&& root,time>580
trigger3 = fvar(10):=0
;trigger4= root,anim=3014&&root,animelemtime(1)>=0
;trigger4 = fvar(10):=0

[State 0, pos y]
type = Null
triggerall = camerazoom > 0.9
triggerall = ishelper(795)
trigger1 = time=0
trigger1 = fvar(2):=3	;fvar(10)
trigger2 =root,anim=3011&& root,time > 580
trigger2 = fvar(2):=5	;fvar(10)

[State 0, zoom]
type = Null
triggerall = camerazoom > 0.9
triggerall = ishelper(795)
trigger1 = time=0
trigger1 = fvar(1):=1.8
trigger2 =root,anim=3006&& root,time > 250 && root,time < 260
trigger2 =  fvar(1):=fvar(1)+-0.045
trigger3 =root,anim=3006&& root,time > 267 && root,time < 299
trigger3 =  fvar(1):=fvar(1)+0.015
trigger4 =root,anim=3007&& root,time > 365 && root,time < 440
trigger4 =  fvar(1):=fvar(1)+-0.008
trigger5 =root,anim=3011&& root,time > 590 && root,time < 675
trigger5 = fvar(1):=fvar(1)+0.005
trigger6 =root,anim=3011&& root,time > 670 && root,time < 680
trigger6 =  fvar(1):=fvar(1)+0.055

;-----------------------------------------------------------------------------------

[State 0, pos y]
type = Null
triggerall = camerazoom < 0.9
triggerall = ishelper(795)
trigger1 = time=0
trigger1 = fvar(2):=5	;fvar(10)
trigger2 =root,anim=3011&& root,time > 580
trigger2 = fvar(2):=5	;fvar(10)

[State 0, zoom]
type = Null
triggerall = camerazoom < 0.9
triggerall = ishelper(795)
trigger1 = time=0
trigger1 = fvar(1):=2.4
trigger2 =root,anim=3006&& root,time > 250 && root,time < 260
trigger2 =  fvar(1):=fvar(1)+-0.045
trigger3 =root,anim=3006&& root,time > 267 && root,time < 299
trigger3 =  fvar(1):=fvar(1)+0.015
trigger4 =root,anim=3007&& root,time > 365 && root,time < 440
trigger4 =  fvar(1):=fvar(1)+-0.008
trigger5 =root,anim=3011&& root,time > 590 && root,time < 675
trigger5 = fvar(1):=fvar(1)+0.005
trigger6 =root,anim=3011&& root,time > 670 && root,time < 680
trigger6 =  fvar(1):=fvar(1)+0.055

[State 0,Zoom]
type = Zoom
triggerall =ishelper(795)
trigger1 = 1
pos = (fvar(10)/fvar(1))* CameraZoom   , fvar(2)
scale = fvar(1);1.2 ;pos option ;zoom in scale(float) ; time gap on zoom?
ignorehitpause=1

[State 200, End]
type = Destroyself
trigger1 = time = 810


