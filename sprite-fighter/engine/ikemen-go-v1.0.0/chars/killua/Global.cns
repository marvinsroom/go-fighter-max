;---------------------------------------------------------------------------
; PerfectGuardHelper
[Statedef 160]
type    = S
movetype= I
physics = N
anim = 160

[State 0, ChangeAnim]
type = ChangeAnim  ;cuando termines activalo
trigger1 = time>2
value = 9999
elem = 1
ignorehitpause = 1
[State 0, NotHitBy]
type = NotHitBy  ;cuando termines activalo
trigger1 = time>2
value = SCA,NA,SA,HA,NP,SP,HP,NT,ST,HT
time = 1
ignorehitpause = 1

[State 0, ChangeAnim]
type = ChangeAnim 
triggerall = time<3
trigger1 = parent,statetype=S
value = 160
elem = 1
ignorehitpause = 1
[State 0, ChangeAnim]
type = ChangeAnim
triggerall = time<3
trigger1 = parent,statetype=C
value = 161
elem = 1
ignorehitpause = 1
[State 0, ChangeAnim]
type = ChangeAnim
triggerall = time<3
trigger1 = parent,statetype=A
value = 162
elem = 1
ignorehitpause = 1

[State 0, BindToParent]
type = BindToParent
trigger1 = 1
time = 1
facing = 1
pos = 1,1
ignorehitpause = 1

[State 0, ReversalDef]
type = ReversalDef
trigger1 = anim=160 || anim=161 || anim=162
reversal.attr = SCA,AA,AP           ;SCA,NA,SA,HA,NP,SP,HP,NT,ST,HT
pausetime = 0,4
sparkno = -1
hitsound = S1,0
p1stateno = 161
ignorehitpause = 1
[State 0, ReversalDef]
type = NULL
trigger1 = anim=161
reversal.attr = C,AA,AP           ;SCA,NA,SA,HA,NP,SP,HP,NT,ST,HT
pausetime = 0,4
sparkno = -1
hitsound = S1,0
p1stateno = 161
ignorehitpause = 1
[State 0, ReversalDef]
type = null
trigger1 = anim=162
reversal.attr = A,AA,AP           ;SCA,NA,SA,HA,NP,SP,HP,NT,ST,HT
pausetime = 0,4
sparkno = -1
hitsound = S1,0
p1stateno = 161
ignorehitpause = 1

[State 155, 7]
type = DestroySelf
trigger1 = parent,stateno!=[120,155]
