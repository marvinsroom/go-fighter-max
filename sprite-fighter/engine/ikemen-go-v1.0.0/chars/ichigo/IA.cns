;===============================================================================
; INTELIGENCIA ARTIFICIAL:
;===============================================================================
[Statedef -2]

[State -2, Clear form effects on manual transition]
type=DestroySelf
triggerall=ishelper
triggerall=!ishelper(999999)
trigger1=root,stateno=900800
ignorehitpause=1


;#ADD004BASIC PIEs#
;//==========================

;//==========================


[State 0, Run]
type = ChangeState
triggerall = ailevel > 0 && roundstate = 2
triggerall = ctrl
triggerall = p2bodydist x > 100
trigger1 = random < (ailevel * 100)/2
trigger2 = random < (ailevel * 100)*2
trigger2 = backedgebodydist < 50
value = 60

;----------Revive----------------------------------------
[State 0, AssertSpecial]
type = AssertSpecial
triggerall = var(4) = 0
trigger1 = enemy, life >= 1
triggerall = var(2) > 0 && var(2) < 6
triggerall = palno = 1
flag = noko
flag2 = nokosnd

[State 0, ChangeState]
type = ChangeState
trigger1 = life < 1
trigger1 = statetype = L && stateno != 899 && var(4) = 0
trigger1 = var(2) > 0 && var(2) < 6
trigger1 = palno = 1
value = 899
ctrl = 0
;--------------------------------------------------------

[State 0, Run Atras]
type = ChangeState
triggerall = backedgebodydist > 50
triggerall = ailevel > 0 && roundstate = 2
triggerall = ctrl
triggerall = p2bodydist x < 100 && p2movetype = A
trigger1 = random < (ailevel * 100)/4
trigger2 = random < (ailevel * 100)
trigger2 = frontedgebodydist < 50
value = 70

[State 0, Jump]
type = ChangeState
triggerall = ailevel > 0 && roundstate = 2
triggerall = ctrl
triggerall = statetype != A
trigger1 = p2dist y <= -20 && p2dist y > -60
trigger2 = random < (ailevel * 100)/50
value = 40

[State 0, SuperJump]
type = ChangeState
triggerall = ailevel > 0 && roundstate = 2
triggerall = ctrl
triggerall = statetype != A
trigger1 = p2dist y <= -60
trigger2 = random < ailevel
value = 80

[State 0, Guard]
type = ChangeState
triggerall = ailevel > 0 && roundstate = 2
triggerall = ctrl
triggerall = (p2bodydist x < 50 && p2movetype = A) || (enemy,numproj > 0)
trigger1 = random < (ailevel * 100)/2
value = ifelse(statetype = A,132,130)

[State 0, Power Charge]
type = ChangeState
triggerall = statetype != A
triggerall = power < powermax
triggerall = ailevel > 0 && roundstate = 2
triggerall = ctrl
triggerall = p2bodydist x > 75
triggerall = !var(47)
trigger1 = random < (ailevel * 100)/4
trigger2 = enemynear,stateno = 500
value = 500

[State 0, Power Charge End]
type = ChangeState
triggerall = time >= 12
triggerall = stateno = 500
triggerall = ailevel > 0
trigger1 = (p2bodydist x < 50) || (enemy,numproj > 0)
trigger2 = power = 3000
trigger2 = random < (ailevel * 100)/8
trigger3 = power = 6000
trigger3 = random < (ailevel * 100)/4
trigger4 = power = 9000
trigger4 = random < (ailevel * 100)/2
trigger5 = power = powermax
value = 501

[State 0, Shunpo]
type = ChangeState
Triggerall = power >= 400
value = 19480
triggerall = ailevel > 0
triggerall = ctrl
triggerall = p2bodydist x >= 100
trigger1 = var(2) = 5 || var(2) = 10
trigger1 = random < (ailevel * 100)/4
trigger2 = var(2) = 4 || var(2) = 9
trigger2 = random < (ailevel * 100)/2
trigger4 = var(2) = 11
trigger4 = random < (ailevel * 100)
trigger5 = var(2) = 0 || var(2) = 6
trigger5 = random < (ailevel * 100)/20
trigger6 = var(2) = 2 || var(2) = 3 || var(2) = 7 || var(2) = 8
trigger6 = random < (ailevel * 100)/10

[State 0, Bankai Activar]
type = ChangeState
triggerall = numhelper(960) = 0
triggerall = statetype != A
triggerall = power >= 2000
Triggerall = life < lifemax*4/5
triggerall = palno = 1
triggerall = var(2) = 0
triggerall = ailevel > 0
triggerall = ctrl
triggerall = p2bodydist x >= 50
trigger1 = random < (ailevel * 100)*10
value = 900

[State 0, Hollow Activar]
type = ChangeState
triggerall = numhelper(970) = 0
triggerall = statetype != A
triggerall = power >= 4000
Triggerall = life < lifemax*3/5
triggerall = palno = 1
triggerall = var(2) = 2
triggerall = ailevel > 0
triggerall = ctrl
trigger1 = random < (ailevel * 100)*5
value = 910

[State 0, Mugetsu Activar]
type = ChangeState
triggerall = statetype != A
triggerall = power >= 7000
Triggerall = life <= lifemax * 2/5
triggerall = var(2) = 5
Triggerall = var(3) = 0
triggerall = palno = 1
triggerall = ailevel > 0
triggerall = ctrl
triggerall = p2bodydist x >= 100
trigger1 = random < (ailevel * 100)*lifemax/life
value = 920

[State 0, Vaste Lord Activar] ;Importance?
