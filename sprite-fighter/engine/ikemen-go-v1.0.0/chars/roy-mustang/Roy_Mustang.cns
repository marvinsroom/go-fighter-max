x = Const(velocity.run.fwd.x)

[State 100, 2] ;Prevent run from canceling into walk
type = AssertSpecial
trigger1 = 1
flag = NoWalk

[State 100, 3] ;Prevent from turning
type = AssertSpecial
trigger1 = 1
flag = NoAutoTurn

[State 100, 4]
type = ChangeState
trigger1 =  ailevel = 0 && command != "holdfwd"
trigger2 = ailevel > 0 && time = 10+random%200
trigger3 = ailevel < 0 && p2bodydist x > 5
value = 0
