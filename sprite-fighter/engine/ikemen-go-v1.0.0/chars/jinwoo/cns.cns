[Data]
life = 1000	
power = 3000
attack = 100
defence = 100
fall.defence_up = 50
liedown.time = 60
airjuggle = 15
sparkno = -1
guard.sparkno = -1
KO.echo = 0
IntPersistIndex = 0
FloatPersistIndex = 40

[Size]
; Base art is already normalized in anim.air. A second 1.5 multiplier made
; Jinwoo 62% taller than Naruto and exaggerated every movement transition.
xscale=1.5
yscale=1.0
ground.back = 15
ground.front = 16
air.back = 12
air.front = 12
height = 60
attack.dist = 160
proj.attack.dist = 90
proj.doscale = 0
head.pos = 0, -50
mid.pos = 0, -30
shadowoffset = 0
draw.offset = 0,0

[Velocity]
; Tuned to the locomotion art: the old 0.8 walk speed made the shoes slide
; through a 36-tick cycle. Jinwoo now takes controlled, deliberate steps.
walk.fwd  = 2.2
walk.back = -2.0
; Ground runs must not carry a positive Y component. Acceleration is fast and
; horizontal, matching Jinwoo's compact anime-style burst movement.
run.fwd  = 7.2,0
run.back = -6.4,0
jump.back = -5
jump.neu = 0,-8.0
jump.fwd = 5
runjump.back = -3.6,-8.4
runjump.fwd = 5.6,-8.4
airjump.neu = 0,-8.0
airjump.back = -3
airjump.fwd = 3

[Movement]
airjump.num = 1
airjump.height = 35
yaccel = .44
stand.friction = .85
crouch.friction = .82

[Quotes]
victory1 = "I am saying you should get ready to become hunted again."
victory2 = "The System uses me, and I use the System."
victory3 = "If I rely too much on my summons, my skills would become rusty."
victory4 = "I'm not strong because I'm invincible. I'm strong because I've been weak."
victory5 = "The only one who can protect me... is me."
victory6 = "You've made the wrong choice. You shouldn't have made me your enemy."
victory7 = "Now, On to the next target."

