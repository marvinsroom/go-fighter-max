[Statedef -2]
type=S
movetype=I
physics=N
ctrl=0

[State -2, Summon cooldown]
type=VarAdd
trigger1=var(31)>0
var(31)=-1

[State -2, Face opponent during every neutral movement state]
type=Turn
triggerall=!ishelper
triggerall=numenemy>0
triggerall=movetype!=A
triggerall=p2dist x<0
trigger1=ctrl && statetype!=A
trigger2=stateno=[10,12]
trigger3=stateno=[20,21]
trigger4=stateno=[40,50]
ignorehitpause=1

[State -2, Face opponent when an attack begins]
type=Turn
triggerall=!ishelper
triggerall=numenemy>0
triggerall=movetype=A
triggerall=time=0
trigger1=p2dist x<0
ignorehitpause=1

[State -2, No automatic turn]
type=AssertSpecial
trigger1=1
flag=noautoturn

[State -2, Use authored walk control]
type=AssertSpecial
trigger1=1
flag=nowalk
flag2=nobrake

[State -2, Keep own proportions in incoming captures]
type=ChangeAnim
trigger1=movetype=H
trigger1=time=1
trigger1=stateno=820 || stateno=821 || stateno=1420 || stateno=3050 || stateno=3250 || stateno=4550
value=ifelse(var(45)>0 && selfanimexist((ifelse(stateno=821 || stateno=1420,5050,5000))+var(45)*10000),(ifelse(stateno=821 || stateno=1420,5050,5000))+var(45)*10000,(ifelse(stateno=821 || stateno=1420,5050,5000)))

[State -2, Random shadow form drawing]
type=ChangeAnim
trigger1=var(45)>0
trigger1=anim<10000
trigger1=selfanimexist(anim+var(45)*10000)
value=anim+var(45)*10000
elem=animelemno(0)

[State -2, Restore Monarch drawing]
type=ChangeAnim
trigger1=var(45)=0
trigger1=anim>=10000
trigger1=selfanimexist(anim%10000)
value=anim%10000
elem=animelemno(0)

[State -2, Keep Jinwoo visible during finishers]
type=SprPriority
trigger1=1
value=ifelse(stateno=3010 || stateno=3210,4,0)

[State -2, Finish guard recovery]
type=ChangeState
trigger1=stateno=140
trigger1=animtime=0
value=ifelse(statetype=C,10,0)
ctrl=1

