[State -2, Equipped dagger artwork]
type=ChangeAnim
triggerall=!ishelper && var(45)=0 && (var(10)=10000 || (var(10)=0 && var(48)=10000))
; Mode actions are numbered 10000+base. Always route them to the locked
; v48 dagger bank at 700000+base instead of probing legacy 710xxx art.
triggerall=(anim<500000)||(anim=[710000,719999])
trigger1=selfanimexist(700000+(anim%10000))
value=700000+(anim%10000)
elem=animelemno(0)
ignorehitpause=1
[State -2, Human greatsword artwork]
type=ChangeAnim
triggerall=!ishelper && var(45)=0 && (var(10)>=20000 || (var(10)=0 && var(48)!=10000))
; Sword mode actions are 20000+base (and some imported 520xxx copies).
; Collapse both forms onto the locked v48 sword bank at 500000+base.
triggerall=(anim<500000)||(anim=[520000,529999])
trigger1=selfanimexist(500000+(anim%10000))
value=500000+(anim%10000)
elem=animelemno(0)
ignorehitpause=1
