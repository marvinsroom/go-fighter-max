[Statedef 56]
type = A
physics = A
Anim = 41
velset = 0,-12
ctrl = 1
hitcountpersist=1

[State 56, PlaySnd]
type = PlaySnd
trigger1 = time = 0
value = S41,0
volume = 255
channel = 1

[State 56, PlaySnd]
type = PlaySnd
trigger1 = time = 0
value = S40,0
volume =5

[State 56, 0]
type = VelAdd
triggerall = prevstateno=420 
trigger1 = command = "holdfwd"||command="fwd"
trigger1 =Anim!= 42
x = 1

[State 56, 3]
type = VelSet
trigger1 = Anim = 42
trigger1 = Time = [0,5]
x = 5

[State 56, 4]
type = VelSet
trigger1 = Anim = 43
trigger1 = Time = [0,5]
x = -3.88

[State 56, 5]
type = ChangeAnim
trigger1 = sysvar(1) = 1 || AILevel
trigger1 = Time = [0,4]
value=42

[State 56, 6]
type = ChangeAnim
trigger1 = sysvar(1) = -1
trigger1 = Time = [0,4]
value = 43

[state 56, VelAdd]
type = VelAdd
trigger1 = Time > 30
x = 0
y = -.20

[State 56, 10]
type = turn
trigger1 = p2dist x < -4

[state 9000, End]
type = ChangeState
trigger1 = Pos Y >= 1
value = 52
ctrl=0
;---------------------------------------------
; RUN_FWD
[Statedef 100]
type    = S
physics = S
anim = 100
sprpriority = 1
ctrl=0

[State 100, NO GUARD] 
type = AssertSpecial
trigger1 = 1
flag =noairguard
flag2=nocrouchguard
flag3=nostandguard

[State 100, 1]
type = VelSet
trigger1 = 1
x = const(velocity.run.fwd.x)

[State 100, 2] ;Prevent run from canceling into walk
type = AssertSpecial
trigger1 = 1
flag = NoWalk

[State 100, 3] ;Prevent from turning
type = AssertSpecial
trigger1 = 1
flag = NoAutoTurn

[State -1, EX Thousand Stab]
type = ChangeState
value = 1010
triggerall=1
triggerall=!AIlevel
triggerall= numhelper(1004)<=0
triggerall= numhelper(1005)<=0
triggerall= numhelper(3003)<=0
triggerall=var(13)!=1
triggerall=power>=500
triggerall=command = "x+y"||command = "x+y"&&command="fwd"||command = "x+y"&&command = "holddown"||command ="y+z"||command ="y+z"&&command="fwd"||command = "y+z"&&command = "holddown"
trigger1=time>=6

[State 100, Jump]
type= changestate
trigger1= command="holdfwd" && command="holdup"
value= 40

[State 100,SuperJump]
type= changestate
trigger1= command = "super jump"
value= 55

[State 100, 4]
type = ChangeState
trigger1 = command != "holdfwd"
trigger1 = !AILevel
trigger2 = AILevel
trigger2 = p2bodydist x <= 100 || p2movetype = A || p2statetype = A
value =101

[State 100, CtrlSet]
type = CtrlSet
trigger1 = time = 0
value = 0
