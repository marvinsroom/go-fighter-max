; Constants and state file.
; There are comments scattered through this file, so you may like to
; take a look if would like to learn more about the cns.

[Data]
life  = 1000			;Amount of life to start with
power = 3000		;Amount of maximum power
attack = 100		;attack power (more is stronger)
defence =100		;defensive power (more is stronger)
fall.defence_up=50	;Percentage to increase defense everytime player is knocked down
liedown.time = 60		;Time which player lies down for, before getting up
airjuggle = 15		;Number of points for juggling
sparkno = 2			;Default hit spark number for HitDefs
guard.sparkno = s8000	;Default guard spark number
KO.echo = 0			;1 to enable echo on KO
volume = 255			;Volume offset (negative for softer)
IntPersistIndex = 60	;Variables with this index and above will not have their values
FloatPersistIndex = 40  ;reset to 0 between rounds or matches. There are 60 int variables,
  				;indexed from 0 to 59, and 40 float variables, indexed from 0 to
  				;If omitted, then it defaults to 60 and 40 for integer and float
  				;variables repectively, meaning that none are persistent, i.e. all
  				;are reset. If you want your variables to persist between matches,
  				;you need to override state 5900 from common1.cns.


[Size]
xscale = .77	;Horizontal scaling factor.
yscale = .72		;Vertical scaling factor.
ground.back = 15		;Player width (back, ground)
ground.front = 16		;Player width (front, ground)
air.back = 12		;Player width (back, air)
air.front = 12		;Player width (front, air)
height = 60			;Height of player (for opponent to jump over)
attack.dist = 160		;Default attack distance
proj.attack.dist = 90	;Default attack distance for projectiles
proj.doscale = 1;		;Set to 1 to scale projectiles too   
head.pos =  -5, -70;10,-80	;Approximate position of head
mid.pos = -2, -46		;Approximate position of midsection
shadowoffset = 0		;Number of pixels to vertically offset the shadow
draw.offset = 0,0		;Player drawing offset in pixels (x, y)

[Velocity]
walk.fwd  = 2.4		;Walk forward
walk.back = -2.2		;Walk backward
run.fwd  = 7,0;5.25, 0		;Run forward (x, y)
run.back = -5,-4	;Hop backward (x, y)
jump.neu = 0,-9.5		;Neutral jumping velocity (x, y)
jump.back = -3.55		;Jump back Speed (x, y)
jump.fwd = 3.5		;Jump forward Speed (x, y)
runjump.back = -2.55,-8.1;Running jump speeds (opt)
runjump.fwd = 4,-8.1	;.
airjump.neu = 0,-8.1	;.
airjump.back = -2.55	;Air jump speeds (opt)
airjump.fwd = 2.5		;.	;.

[Movement]
airjump.num = 0		;Number of air jumps allowed (opt)
airjump.height = 35	;Minimum distance from ground before you can air jump (opt)
yaccel = .46		;Vertical acceleration
stand.friction  = .85	;Friction coefficient when standing
crouch.friction = .82	;Friction coefficient when crouching
;The default language victory quotes must be implemented in English.
[Quotes]
; Up to 100 victory quotes can be specified per language (victory0 - victory99)
victory1 = "I shoulda warned ya' pal, this might sting a little!"
victory2 = "Kiss my shell ya wusses!"
victory3 = "This guy's got the reflexes of a banana slug!"
victory4 = "What the shell was that?"
victory5 = "Clean yerself off, you're bleedin'."
victory6 = "Where'd you learn to fight, clown college?"
victory7 = "Tough rocks, pal!"
victory8 = "You guys must be studying the abridged book of ninja fighting!"
victory9 = "How do you expect to beat me?"
victory10= "Weak."
victory11= "Come back when you can put up a fight."
;---------------------------------------------------------------------------
;VARIABLES ( VAR / VARS INDEX)

;var(1)  used for WEAK MEDIUM HEAVY Special Command Recognition
;var(2)  used for WEAK MEDIUM HEAVY Special Command Recognition
;var(3)  used for SUPER [StateDef 3400] Land Recognition
;var(4)  used for Intro Poses
;var(5)  used for Intro Poses
;var(6)  used for Guard Push
;var(7)  used for ENEMY BOUND / WALL HIT Target, ID
;var(8)  used for ENEMY BOUND / WALL HIT Target, ID
;var(9)  use for ENEMY BOUND / FLOOR HIT Target, ID
;var(10) used for ENEMY BOUND

;var(11) used for ShoulderSmash/Wall Hit variable recognition
;var(12) used for EXThousand Stab Type recognition
;var(13) used for EXThousand Stab variable recognition
;var(15) used for SKY-RIPPER Special Command Recognition
; var(28)    =     P2 Opponent ID
; var(29)    =     P4 Opponent ID

;var(30) used for SUPER KO FINISH
;var(38) used to disallow throws
;var(50) used for Damage Scaling
;var(55) used for Super Cancel Recognition

;---------------------------------------------------------------------------
; Stand
[Statedef 0]
type = S
physics = S
sprpriority = 0
hitcountpersist=Ifelse((Time>=7),0,1)

[State 0, RemoveExplod]; Super BG
type = Removeexplod 
trigger1=1
anim=3402
ID = 3402

[State 0, RemoveExplod]; Super BG
type = Removeexplod 
trigger1=1
anim=3403
ID = 3403

[State 0, RemoveExplod]; Super BG
type = Removeexplod 
trigger1=1
anim=3404
ID = 3404

[State 0, RemoveExplod]; Super BG
type = Removeexplod 
trigger1=1
anim=3405
ID = 3405

[State 0, RemoveExplod]; Super BG
type = Removeexplod 
trigger1=1
anim=3406
ID = 3406

[State 0, RemoveExplod]; Super BG
type = Removeexplod 
trigger1=1
anim = 8506
ID = 8506

[State 0, RemoveExplod]; Super BG
type = Removeexplod 
trigger1=1
anim=8508
ID = 8520

[State 0, RemoveExplod]; Super BG
type = Removeexplod 
trigger1=1
anim=8508
ID = 8521

[State 0, Varset]
type = VarSet
trigger1 = Time = 0
v=3
value=0

[State 0, 1]
type = ChangeAnim
trigger1 = Anim != 0 && Anim != 5
trigger2 = Anim = 5 && AnimTime = 0 ;Turn anim over
value = 0

[State 0, 2]
type = VelSet
trigger1 = Time = 0
y = 0

[State 0, 3] ;Stop moving if low velocity or 4 ticks pass
type = VelSet
trigger1 = abs(vel x) < 2
trigger2 = Time = 4
x = 0

[State 0, 4] ;Are you dead?
type = ChangeState
trigger1 = !alive
value = 5050

[State 826, 5]
type =AssertSpecial
triggerall=1
triggerall=Roundstate=4
triggerall=prevstateno=180
triggerall=(Enemy,name="DcatShredder")&&(Enemy,stateno=5150)
trigger1=!Time
trigger2=1
flag=nofg	
flag2=noshadow
ignorehitpause=1
[State 0, 4] ; END THE MATCH
type = CtrlSet
triggerall=1
triggerall=Roundstate=4
trigger1 =prevstateno=180
trigger1 =(Enemy,name="DcatShredder")&&(Enemy,stateno=5150)
value=ifelse((!time),1,0)
ignorehitpause=1
