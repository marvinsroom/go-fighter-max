;---------------------------------------------------------------------------
; 2. State entry
; --------------
; This is where you define what commands bring you to what states.
;
; Each state entry block looks like:
;   [State -1, Label]           ;Change Label to any name you want to use to
;                               ;identify the state with.
;   type = ChangeState          ;Don't change this
;   value = new_state_number
;   trigger1 = command = command_name
;   . . .  (any additional triggers)
;
; - new_state_number is the number of the state to change to
; - command_name is the name of the command (from the section above)
; - Useful triggers to know:
;   - statetype
;       S, C or A : current state-type of player (stand, crouch, air)
;   - ctrl
;       0 or 1 : 1 if player has control. Unless "interrupting" another
;                move, you'll want ctrl = 1
;   - stateno
;       number of state player is in - useful for "move interrupts"
;   - movecontact
;       0 or 1 : 1 if player's last attack touched the opponent
;                useful for "move interrupts"
;
; Note: The order of state entry is important.
;   State entry with a certain command must come before another state
;   entry with a command that is the subset of the first.  
;   For example, command "fwd_a" must be listed before "a", and
;   "fwd_ab" should come before both of the others.
;
; For reference on triggers, see CNS documentation.
;
; Just for your information (skip if you're not interested):
; This part is an extension of the CNS. "State -1" is a special state
; that is executed once every game-tick, regardless of what other state
; you are in.


; Don't remove the following line. It's required by the CMD standard.
[Statedef -1]

;---------------------------------------------------------------------------
;===========================================================================
;=================================< A.I. >==================================
;===========================================================================

[State -1]
Type=Changestate
Triggerall=Inguarddist ; Guard when in guard distance
triggerall = AIlevel = 3 && random <= 32 || AIlevel = 4 && random <= 64 || AIlevel = 5 && random <= 72 || AIlevel = 6 && random <= 94 || AIlevel = 7 && random <=250 || AIlevel = 8 && random <= 999 ; and the AI is on
trigger1 = stateno!=[120,160]
Trigger1=ctrl ; and we have control
value=120

;Guard Push
[State -1]
type = ChangeState
value = 720
triggerall = var(10) != 1&&statetype = S&&p2life!=0
triggerall = AIlevel = 1 && random <= 6 || AIlevel = 2 && random <= 16 || AIlevel = 3 && random <= 32 || AIlevel = 4 && random <= 64 || AIlevel = 5 && random <= 72 || AIlevel = 6 && random <= 94 || AIlevel = 7 && random <=250 || AIlevel = 8 && random <= 999
trigger1 = stateno = [150,153]
;-------------------------------------
[State -1]
type =ChangeState
value = 725
triggerall = var(10) != 1&&statetype = C&&p2life!=0
triggerall = AIlevel = 1 && random <= 6 || AIlevel = 2 && random <= 16 || AIlevel = 3 && random <= 32 || AIlevel = 4 && random <= 64 || AIlevel = 5 && random <= 72 || AIlevel = 6 && random <= 150 || AIlevel = 7 && random <=250 || AIlevel = 8 && random <= 999
trigger1 = stateno = [150,153]
;-------------------------------------
[State -1]
type =ChangeState
value = 730
triggerall = var(10) != 1&&statetype = A&&p2life!=0
triggerall = AIlevel = 1 && random <= 6 || AIlevel = 2 && random <= 16 || AIlevel = 3 && random <= 32 || AIlevel = 4 && random <= 64 || AIlevel = 5 && random <= 72 || AIlevel = 6 && random <= 150 || AIlevel = 7 && random <=250 || AIlevel = 8 && random <= 999
trigger1 = stateno = [154,155]
;===========================================================================
;---------------------------------------------------------------------------
; Taunt
[State -1, Taunt]
type = ChangeState
value = 195
triggerall = AILevel
triggerall = roundstate!=[3,4]
triggerall = statetype != A
triggerall = ctrl
triggerall = enemynear, numproj = 0
triggerall = enemynear, movetype != A
triggerall = life >= 400
trigger1 = p2bodydist x >= 150
trigger1 = life >= enemynear, life
trigger1 = random <= 6 && AILevel >= 6 || random <= 20 && AILevel >= 3 && AILevel <= 5 || random <= 40 && AILevel >= 1 && AILevel <= 2
trigger2 = p2bodydist x >= 150
trigger2 = p2statetype = L
trigger2 = random <= 12 && AILevel >= 6 || random <= 32 && AILevel >= 3 && AILevel <= 5 || random <= 56 && AILevel >= 1 && AILevel <= 2
trigger3 = win && random <= 57
;---------------------------------------------------------------------------
[State -1, HYPER COMBO]
type = ChangeState
value = 3300
triggerall = AILevel >= 5
triggerall= power>=3000
triggerall = statetype != A
triggerall = roundstate = 2
trigger1 = ctrl
trigger1 = prevstateno = 5120
trigger1 = p2bodydist x <= 150
trigger1 = enemynear, statetype != A
trigger1 = enemynear,movetype = A
trigger1 = Random < (500 * (AILevel ** 2 / 64.0)) || AILevel = 8
trigger1 = AILevel >= 6
trigger2 = ctrl
trigger2 = p2bodydist x <= 100
trigger2 = enemynear, statetype != A
trigger2 = enemynear,movetype = A
trigger2 = Random < (500 * (AILevel ** 2 / 64.0)) || AILevel = 8
trigger2 = AILevel >= 6
trigger3 = stateno = 220
trigger3 = enemynear,statetype = A && enemynear,movetype = H
trigger3 = movehit
trigger3 = Random < (500 * (AILevel ** 2 / 64.0)) || AILevel = 8
trigger4 = p2bodydist x <= 100
trigger4 = p2statetype != A
trigger4 = p2statetype != L
trigger4 = Random < (50 * (AILevel ** 2 / 64.0))
trigger4 = ctrl
;---------------------------------------------------------------------------
; Rampage SUPER
[State -1, Rampage Super]
type = ChangeState
value = 3000
triggerall = AILevel
triggerall = power>=1000
triggerall= statetype  != A
triggerall = roundstate = 2
trigger1 = ctrl
trigger1 = prevstateno = 5120
trigger1 = enemynear, p2bodydist x <= 150
trigger1 = enemynear, statetype != A
trigger1 = enemynear,movetype = A
trigger1 = Random < (500 * (AILevel ** 2 / 64.0)) || AILevel = 8
trigger1 = AILevel >= 6
trigger2 = ctrl
trigger2 = enemynear, p2bodydist x <= 100
trigger2 = enemynear, statetype != A
trigger2 = enemynear,movetype = A
trigger2 = Random < (500 * (AILevel ** 2 / 64.0)) || AILevel = 8
trigger2 = AILevel >= 6
trigger3 = stateno = 210 || stateno = 220
trigger3 = movehit
trigger3 = Random < (25 * (AILevel ** 2 / 64.0))
;---------------------------------------------------------------------------
; Powerdrill SUPER
[State -1, Powerdrill Super]
type = ChangeState
value = 3100
triggerall = AILevel
triggerall = power>=1000
triggerall= statetype  != A
triggerall = roundstate = 2
trigger1 = ctrl
trigger1 = prevstateno = 1024
trigger1 = p2movetype = H
trigger1 = AILevel >= 5
trigger2 = stateno = 250
trigger2 = movehit
trigger2 = p2bodydist x >= 55
trigger2 = Random < (500 * (AILevel ** 2 / 64.0)) || AILevel = 8
trigger3 = stateno = 251
trigger3 = movehit
trigger3 = p2bodydist x <= 54
trigger3 = Random < (500 * (AILevel ** 2 / 64.0)) || AILevel = 8
trigger4 = stateno = 210 || stateno = 220
trigger4 = movehit
trigger4 = Random < (30 * (AILevel ** 2 / 64.0))
trigger5 = p2statetype = L
trigger5 = enemynear,stateno != 5120
trigger5 = enemynear, time <= 6
trigger5 = Random < (100 * (AILevel ** 2 / 64.0))
trigger5 = p2bodydist x <= 100
trigger6 = stateno = 410
trigger6 = movehit
trigger6 = p2bodydist x >= 63
trigger6 = Random < (500 * (AILevel ** 2 / 64.0))
;---------------------------------------------------------------------------
; POWER DRILL SUPER - IN THE AIR
