Triggerall = statetype != A
trigger1 = ctrl
trigger2 = numhelper(700) > 0
;===========================================================================
;--------------------------------Ataques Normales---------------------------
;---------------------------------------------------------------------------
; Down A
[State -1, Down A]
type = ChangeState
triggerall = var(2) = 0
value = 230
triggerall = command = "down_a"
