Value = SCA,NA,SA,HA,NP,SP,HP,NT,ST,HT
Time = 1
IgnoreHitPause = 1

[State 0]
Type = ChangeAnim
Trigger1 = StateNO = 101
Value = Var(1)
Elem = Var(2)
IgnoreHitPause = 1

[State 0]
Type = AngleDraw
Trigger1 = Parent,StateNO = 100
Scale = 1 + (Time * 0.01),1 + (Time * 0.01)
IgnoreHitPause = 1

[State 0]
Type = PalFX
Trigger1 = !Time
Time = -1
Mul = 256,256,256
IgnoreHitPause = 1

[State 0]
Type = Trans
Trigger1 = StateNO = 101
Trans = AddAlpha
Alpha = 75 - Cond(Time < 5,0,Ceil((Time - 5) * 15)),256
IgnoreHitPause = 1

[State 0]
Type = DestroySelf
Trigger1 = Time = 10
IgnoreHitPause = 1
