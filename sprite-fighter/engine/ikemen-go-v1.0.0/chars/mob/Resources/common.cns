Trigger1 = !Time
Trigger1 = Var(1) := Parent,Anim
IgnoreHitPause = 1

[State 0]
Type = Null
Trigger1 = !Time
Trigger1 = Var(2) := Parent,AnimElemNO(0)
IgnoreHitPause = 1

[State 0]
