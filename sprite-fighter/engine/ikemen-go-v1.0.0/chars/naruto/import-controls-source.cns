;===============================================================================
; INTELIGENCIA ARTIFICIAL:
;===============================================================================
[Statedef -2]
;========================================================================
[State 0, KURAMA MODE Activar]
type = ChangeState
triggerall = statetype != A
triggerall = power >= 1500
Triggerall = var(2) < 5
Triggerall = var(2) > 1
triggerall = ailevel > 0 && roundstate = 2
triggerall = ctrl
triggerall = p2bodydist x >= 80
trigger1 = random < 50
value = 10001

[State 0, Run]
type = ChangeState
triggerall = var(2) = 0||var(2) = 1||var(2) = 5||var(2) = 6
triggerall = ailevel > 0 && roundstate = 2
triggerall = ctrl
triggerall = ailevel > 0 && random < (ailevel * 100)/8
trigger1 = random < (ailevel * 100)/2
value = ifelse(pos y < 0,65,60)

[State 0, Run Back]
type = ChangeState
triggerall = var(2) = 0||var(2) = 1||var(2) = 5||var(2) = 6
triggerall = backedgebodydist > 50
triggerall = ailevel > 0 && roundstate = 2
triggerall = ctrl
triggerall = p2bodydist x < 100 && p2movetype = A
trigger1 = random < (ailevel * 100)/4
value = ifelse(pos y < 0,75,70)

[State 0, Run Ashura]
type = ChangeState
triggerall = var(2) < 5
triggerall = var(2) > 1
triggerall = ailevel > 0 && roundstate = 2
