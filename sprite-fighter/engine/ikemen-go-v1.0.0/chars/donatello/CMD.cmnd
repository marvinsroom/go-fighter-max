trigger4 = stateno = 611 
trigger4 = random <=150 &&animelem>=5&&movehit||random <=25 &&animelem>=2&&movecontact
trigger5=stateno=1010
trigger5=anim=1010 && MoveContact
trigger5=animelemtime(6)>=1&&Pos Y <=-30

