;---------------------------------------------------------------------------
; 2. State entry
; --------------
; This is where you define what commands bring you to what states.
;
; Each state entry block looks like:
;   [State -1, Label]           ;Change Label to any name you want to use to
;                               ;identify the state with.
;   type = ChangeState          ;Don't change this
;   value = new_state_number
;   trigger1 = command = command_name
;   . . .  (any additional triggers)
;
; - new_state_number is the number of the state to change to
; - command_name is the name of the command (from the section above)
; - Useful triggers to know:
;   - statetype
;       S, C or A : current state-type of player (stand, crouch, air)
;   - ctrl
;       0 or 1 : 1 if player has control. Unless "interrupting" another
;                move, you'll want ctrl = 1
;   - stateno
;       number of state player is in - useful for "move interrupts"
;   - movecontact
;       0 or 1 : 1 if player's last attack touched the opponent
;                useful for "move interrupts"
;
; Note: The order of state entry is important.
;   State entry with a certain command must come before another state
;   entry with a command that is the subset of the first.
;   For example, command "fwd_a" must be listed before "a", and
;   "fwd_ab" should come before both of the others.
;
; For reference on triggers, see CNS documentation.
;
; Just for your information (skip if you're not interested):
; This part is an extension of the CNS. "State -1" is a special state
; that is executed once every game-tick, regardless of what other state
; you are in.


; Don't remove the following line. It's required by the CMD standard.
[Statedef -1]
;===========================================================================
;================================AI=========================================
;===========================================================================
;===========================================================================

[State -1, WRIST LOOP STRIKE SUPER]
type = Changestate
value = ifelse((random<=250&&prevstateno!=3100&&prevstateno!=3105),3100,3000)
triggerall = numhelper(3106)<=0
triggerall = AIlevel = 1 && random <= 6 || AIlevel = 2 && random <= 16 || AIlevel = 3 && random <= 32 || AIlevel = 4 && random <= 64 || AIlevel = 5 && random <= 72 || AIlevel = 6 && random <= 94 || AIlevel = 7 && random <=250 || AIlevel = 8 && random <= 999
triggerall = roundstate = 2
triggerall = Statetype != A
triggerall = power >= 1000
trigger1 = ctrl && p2statetype = A && p2movetype = H && p2bodydist X <= 25
trigger2 = p2bodydist x <= 35 && enemynear, ctrl = 0
trigger2 = ctrl

; POLE VAULT KICK SUPER
[State -1, POLE VAULT KICK SUPER]
type = ChangeState
value = 3100
triggerall = roundstate = 2
triggerall = AIlevel = 1 && random <= 6 || AIlevel = 2 && random <= 16 || AIlevel = 3 && random <= 32 || AIlevel = 4 && random <= 64 || AIlevel = 5 && random <= 72 || AIlevel = 6 && random <= 94 || AIlevel = 7 && random <=250 || AIlevel = 8 && random <= 999
triggerall = power >= 1000
triggerall = statetype != A
trigger1 = stateno = 450 && movehit
trigger2 = stateno = 460 && movehit && Time >=30
trigger3 = stateno = 401 && animelem>=5 && movehit
trigger4 = ctrl && Time >=30
trigger4 = enemynear, stateno = 424
trigger4 = enemynear,movetype = H 
trigger4 = enemynear,vel Y>=0
trigger4 = random <= 30

; CENTRIFUGE SUPER COMBO - IN THE AIR
[State -1, CENTRIFUGE SUPER]
type = ChangeState
value = 3200
triggerall = roundstate = 2
triggerall = AIlevel = 1 && random <= 6 || AIlevel = 2 && random <= 16 || AIlevel = 3 && random <= 32 || AIlevel = 4 && random <= 64 || AIlevel = 5 && random <= 72 || AIlevel = 6 && random <= 94 || AIlevel = 7 && random <=250 || AIlevel = 8 && random <= 999
triggerall = power >= 1000
triggerall = statetype = A
trigger1 = stateno=640&&movehit
trigger2 = stateno=650&&movehit
trigger3 = stateno=1010&&movehit
trigger4 = stateno=3100&&movehit && animelemtime(25)>=0;time >= 30
trigger5= stateno=3000&&movehit && time >= 30
trigger6= stateno=2000&&movehit && time >= 30
trigger7= stateno=2001&&movehit && time >= 30
;---------------------------------------------------------------------------
;=================================
; JUGULAR JAMB / OVER EASY
[State -1, JUGULAR JAMB]
type = ChangeState
value = ifelse((random<300),1600,1700)
triggerall = roundstate = 2
triggerall = AIlevel = 1 && random <= 6 || AIlevel = 2 && random <= 16 || AIlevel = 3 && random <= 32 || AIlevel = 4 && random <= 64 || AIlevel = 5 && random <= 72 || AIlevel = 6 && random <= 150 || AIlevel = 7 && random <=250 || AIlevel = 8 && random <= 999
triggerall = statetype=A
triggerall= Pos Y<=-50
trigger1 = Time >= 24
trigger1 = ctrl
trigger1 = p2statetype != A
trigger1 = enemynear, movetype != A
trigger1 = enemynear, numproj = 0
trigger1 = p2bodydist X >= 66
trigger1 = random <= 72
trigger2 = Time >= 24
trigger2 = p2bodydist x >= 66
trigger2 = p2statetype = C || p2statetype = L
trigger2 = ctrl
trigger2 = AIlevel >= 6
trigger3 = Time >= 24
trigger3 = p2bodydist X<=115;135	
trigger3 = p2statetype != L
trigger3 = p2statetype = A &&p2bodydist Y<=140&&p2bodydist Y>=-140
trigger3 = ctrl
trigger3 = random <= 44
trigger4 = stateno = 610||stateno = 620||(stateno=[630,650])
trigger4 = movecontact
trigger4 = random <= 72
trigger5 = stateno = 611 
trigger5 = random <=150 &&animelem>=5&&movehit||random <=250 &&animelem>=2&&movecontact
trigger6=stateno=1010
trigger6=anim=1010 && MoveContact
trigger6=animelemtime(6)>=1&&Pos Y <=-30

;=================================
; EX JUGULAR JAMB
