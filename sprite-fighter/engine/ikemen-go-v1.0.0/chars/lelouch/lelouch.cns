;-| タゲ取得フラグ |---------------------------------------------------------------------------------------------------
[State -2, マーキングフラグリセット]
type = VarSet
triggerall = !ishelper       ;本体だよー
triggerall = var(0)
triggerall = numhelper(10000)
trigger1 = roundstate < 1
trigger2 = !helper(10000),var(2)
var(0) = 0
ignorehitpause = 1
[State -2, マーキングフラグセット]
type = VarSet
triggerall = !ishelper
triggerall = !var(0)
triggerall = numhelper(10000)
trigger1 = helper(10000),var(2)
var(0) = 1
ignorehitpause = 1

;-| タゲ取得ヘルパー |---------------------------------------------------------------------------------------------------
[State -2, 当身型マーキングヘルパー]
type = Helper
triggerall = !ishelper
triggerall = palno != 3
trigger1 = !numHelper(10000)
helpertype = player
name = "Marking1"
stateno = 10000
ID = 10000
postype = p1
pos = 0, 0
supermovetime = 2147483647
pausemovetime = 2147483647
ignorehitpause = 1

[State -2, 相手ライフ監視0-1]
