trigger1 = enemy(1),Life = enemy(1),LifeMax
var(1) = enemy(1),Life
ignorehitpause = 1

[State -2, 相手ライフ監視1-2]
type = VarSet
triggerall = ishelper(10000)
trigger1 = enemy(1),Life  < var(1)
var(1) = enemy(1),Life
ignorehitpause = 1

[State -2, 固定]
type = SelfState
trigger1 = ishelper(10000)
value = 10000
ignorehitpause = 1


[State -2, 保護1]
Type = SelfState
Triggerall = IsHelper(10000)
trigger1 = Stateno != 10000
Trigger2 = GameTime != sysvar(4)
