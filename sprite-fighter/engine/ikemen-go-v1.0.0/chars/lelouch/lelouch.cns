[state 156, ヘルパーカメラ固定]
type = screenbound
trigger1 = ishelper
value = 0
ignorehitpause = 1

[state -3]
type = lifeset
Triggerall = !ishelper
triggerall = 500 <= lifemax
triggerall = alive
triggerall = palno >= 7
trigger1 = var(50)-life > 500
trigger2 = gethitvar(damage) >= 500
value = var(50)
IgnoreHitPause = 1
SuperMoveTime = 999999
PauseMoveTime = 999999

[state -3]
type = lifeset
Triggerall = !ishelper
triggerall = palno >= 7
trigger1 = movetype != H && var(50) > life
trigger2 = roundstate >= 3
value = lifemax
IgnoreHitPause = 1
SuperMoveTime = 999999
PauseMoveTime = 999999

