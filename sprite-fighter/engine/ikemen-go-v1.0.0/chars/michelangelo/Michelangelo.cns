[State -3, Variable Height]
type= playerpush
triggerall= statetype=A && movetype!=H && numenemy
triggerall= p2bodydist x = [-(enemynear,const(size.ground.back) + enemynear,const(size.ground.front)), 0]; checks if both characters are within each other's width
trigger1= p2statetype=S
trigger1= p2dist y >= (enemynear,const(size.height) - 22)
trigger2= p2statetype=C
trigger2= p2dist y >= (enemynear,const(size.height) - 48)
trigger3= p2statetype=L
trigger3= p2dist y >= 11
value= 0
ignorehitpause= 1

;This controller plays a sound everytime KFM lands from a jump, or
;from his back-dash.

[State -3, Landing Sound]
type = PlaySnd
triggerall = Time = 1
trigger1 = stateno = 52 ;Jump land
trigger2 = stateno = 106 ;Run-back land
trigger3 = stateno = 890
value = s52,0
volume=50
volumescale=120
;channel=0

[State -3, Jumping Sound]
type = PlaySnd
triggerall = Time = 1
trigger1 = stateno = 40
trigger2 = stateno = 230
value=s40,0


[State -3, Running Sound]
type = PlaySnd
trigger1 = stateno = 100 &&animelemtime(2)=0
trigger2 = stateno = 100 &&animelemtime(4)=0
trigger3 = stateno = 105 &&animelemtime(2)=0
trigger4 = stateno = 105 &&animelemtime(4)=0
value = s100,0
volume=255



[State -3, Bouncing Sound]
type = PlaySnd
triggerall = Time = 1
trigger1 = stateno = 5100
trigger2 = stateno = 5170
trigger3 = stateno = 5110
value= 810, 0


[State -3, STRONG Whoosh]
type = PlaySnd
triggerall = Time = 1
trigger1 = stateno = 220
value=s600, 3
volume=255
channel=0

[State -3, Whiffing Sound]
type = PlaySnd
triggerall = Time = 1
trigger1 = stateno = 240
trigger2 = stateno = 420
trigger3 = stateno = 221
value=s0, 4
volume=255
channel=0
[State -3, Whiffing Sound]
type = PlaySnd
triggerall = Time = 1
trigger1 = stateno = 250
value=s0, 2
volume=255
channel=0
[State -3, LIGHT Whoosh]
type = PlaySnd
triggerall = Time = 1
trigger1 = stateno = 200&&anim=200
trigger2 = stateno = 600
trigger3 = stateno = 610
value=s600, 0+(random%2)
volume=255
volumescale=156
channel=0
[State -3, MEDIUM Whoosh]
type = PlaySnd
triggerall = Time = 1
trigger1 = stateno = 210
trigger2 = stateno = 410
value=s600, 2
volume=255
channel=0



