;------------- GROUND BOUNCE ---------------------
[State -2, VarSet]
type = VarSet
triggerall=1
triggerall=var(12)!=2
trigger1=numtarget(3303)
trigger1=(Enemy(0),prevstateno=1029)
trigger1=(Enemy(0),stateno=5100)&&(Enemy(0),movetype=H)
trigger1=(Enemy(0),time<=1)
trigger2=numtarget(3303)
trigger2=TeamMode = Simul
trigger2=(Enemy(1),prevstateno=1029)
trigger2=(Enemy(1),stateno=5100)&&(Enemy(1),movetype=H)
trigger2=(Enemy(1),time<=1)
trigger3=numtarget(3303)
trigger3=Enemy(Enemy, TeamMode = Simul),prevstateno=1029
trigger3=Enemy(Enemy, TeamMode = Simul),stateno=5100&&(Enemy(Enemy, TeamMode = Simul),movetype=H) 
trigger3=Enemy(Enemy, TeamMode = Simul),time<=1
trigger4=numtarget(3303)
trigger4=Enemy,stateno=5100&&Enemy,prevstateno=1029
trigger4=Enemy,movetype=H
ignorehitpause=1
v=12
value=2

