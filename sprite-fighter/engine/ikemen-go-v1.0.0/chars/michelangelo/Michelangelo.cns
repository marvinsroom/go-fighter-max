trigger1 = 1
value = 1
movecamera = 1,1

[State 7689, 6]
type = NotHitBy
trigger1 = 1
value = SCA

[State 7689, 7]
type = PlayerPush
trigger1 = 1
ignorehitpause=1
value = 0

