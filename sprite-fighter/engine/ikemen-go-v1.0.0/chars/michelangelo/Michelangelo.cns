type = Removeexplod 
trigger1=alive
ID = 5306

[State -3, RemoveExplod];Dizzy Stars
type = Removeexplod 
trigger1=anim!=170
ID = 5305

[State -3, No scroll]
type = ScreenBound
trigger1 =Enemy, stateno=1027
trigger1 =time>9
value = 1
movecamera = 0,1

[State -3, GetHurt Sound]
type = PlaySnd
triggerall = Random < 500
triggerall = Time = 1
triggerall = alive
trigger1 = StateNo = 5000 || StateNo = 5010 || StateNo = 5020 || StateNo = 5070 || StateNo = 5080 || StateNo = 5100
value = 5000, ifelse(StateNo = 5100 || GetHitVar(animtype) = 2,2, ifelse(GetHitVar(animtype) = 1, 1, 0))
channel = 10

[State -3, Voice]
type = Stopsnd
trigger1 = StateNo = 5000 || StateNo = 5010 || StateNo = 5020 || StateNo = 5070 || StateNo = 5080 || StateNo = 5100
;trigger2 = StateNo = [150,159]
channel = 0

[State -3, Voice]
type = Stopsnd
trigger1 = StateNo = 0&& numhelper(8590)>=1
channel = 0
ignorehitpause = 1

[State -3, Voice]
type = Stopsnd
trigger1 = movetype=H
channel = 12
ignorehitpause = 1


[State -3, Prevent Crossup]
