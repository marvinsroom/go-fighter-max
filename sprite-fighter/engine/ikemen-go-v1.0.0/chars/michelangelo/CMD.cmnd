trigger2 = stateno = 600 || stateno = 630
trigger2 = movecontact
trigger3 = stateno = 1350 ;Air blocking
trigger4 = stateno=640&&movecontact
;---------------------------------------------------------------------------
; Jump Strong Punch
[State -1, Jump Strong Punch]
type = ChangeState
value = ifelse((numhelper(713)>=1||command="holddown"),625,620)
triggerall = !AILevel
;triggerall=numhelper(713)<=0
triggerall = command = "z"
triggerall = command!= "c"
trigger1 = statetype = A
trigger1 = ctrl
trigger2 = stateno=600&&movecontact
trigger2 = pos y<=-30
trigger3 = stateno=610&&movecontact
trigger3 = pos y<=-35
trigger4 = (stateno=[611,612])&&movecontact
trigger4 = pos y<=-35
trigger5 = stateno=630&&movecontact
trigger5 = pos y<=-30
trigger6 = stateno=640&&movecontact
trigger6 = pos y<=-30
;---------------------------------------------------------------------------
;Jump Light Kick
[State -1, Jump Light Kick]
type = ChangeState
value = 630
triggerall = !AILevel
triggerall = command = "a"
triggerall = command!= "EX_DiveKick"
triggerall = command!= "DiveKick"
triggerall = command!= "SUPER2"
trigger1 = statetype = A
trigger1 = ctrl
trigger2 = stateno = 1350 ;Air blocking
trigger3 = stateno=600&&movecontact
trigger4 = stateno=610&&movecontact
trigger5 = stateno=611&&movecontact
trigger6 = stateno=612&&movecontact
trigger7 = stateno=640&&movecontact
;---------------------------------------------------------------------------
;Jump Medium Kick
[State -1, Jump Medium Kick]
type = ChangeState
value =  640
triggerall = !AILevel
triggerall = command = "b"
triggerall = command!= "EX_DiveKick"
triggerall = command!= "DiveKick"
triggerall = command!= "SUPER2"
trigger1 = statetype = A
trigger1 = ctrl
trigger2 = stateno = 1350 ;Air blocking
trigger3 = stateno=600&&movecontact
trigger4 = stateno=610&&movecontact
trigger5 = stateno=611&&movecontact
trigger6 = stateno=612&&movecontact
trigger7 = stateno=630&&movecontact
;---------------------------------------------------------------------------
; Jump Strong Kick
[State -1, Jump Strong Kick]
type = ChangeState
value = ifelse((command="holdup"&&numhelper(664)=0),655,650)
triggerall = !AILevel
triggerall = command ="c"
triggerall = command!="z"
triggerall = command!= "EX_DiveKick"
triggerall = command!= "DiveKick"
triggerall = command!= "SUPER2"
trigger1 = statetype = A
trigger1 = ctrl
trigger2 = stateno=600&&movecontact
trigger3 = stateno=610&&movecontact
trigger4 = stateno=611&&movecontact
trigger5 = stateno=612&&movecontact
trigger6 = stateno=630&&movecontact
trigger7 = stateno=640&&movecontact
