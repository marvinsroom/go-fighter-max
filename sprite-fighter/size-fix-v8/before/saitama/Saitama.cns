type = lifeadd
triggerall = command != "hold_start"
triggerall = command != "start"
triggerall = stateno != 196
trigger1 = alive
trigger1 = life < 1000
trigger2 = alive
trigger2 = NumHelper(11778)>0
value = 9999999

[State -2, ]
