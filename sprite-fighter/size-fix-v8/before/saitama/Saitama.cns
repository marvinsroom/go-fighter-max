;---------------------------------------------------------------------------
; Introduction 1; Snoring, then wake up and say alright let's go
[Statedef 191]
type = S
ctrl = 0
anim = 190
velset = 0,0

[State 191, 1] ;Freeze animation until PreIntro is over
type = ChangeAnim
trigger1 = RoundState = 0
value = 190

[State 191, 2] ;Assert this until you want "round 1, fight" to begin
type = AssertSpecial
trigger1 = 1
flag = Intro

[state ]
type = playsnd
trigger1 = time = 0
value = s2,17
channel = 4

[state ]
type = playsnd
trigger1 = animelem = 2
value = s2,14
channel = 4

[state ]
type = playsnd
trigger1 = animelem = 3
value = s2,55
channel = 4

[State 191, 3] ;Change to stand state when done
type = ChangeState
trigger1 = AnimTime = 0
value = 0

