;---------------------------------------------------------------------------
; Override common states (use same number to override) :
;---------------------------------------------------------------------------

;---------------------------------------------------------------------------
; States that are always executed (use statedef -2)
;---------------------------------------------------------------------------
[statedef -2]

[State -2]
type = stopSnd
trigger1 = stateno != 2005
channel = 7

[State -2]
Type=Assertspecial
Trigger1=var(37)>0
Trigger1=P2life>0
Trigger2=P2life>0
trigger3=life < gethitvar(damage)
flag=NoKo
ignorehitpause=1

[State -2]
Type=Lifeset
Trigger1=var(37)>0
Trigger1=Life<=0
Trigger2=Life<=0
trigger3=life < gethitvar(damage)
value=1
ignorehitpause=1

[State -2]
Type=VarSet
Trigger1=1
var(37)=((movetype=H) && (var(37)>0)) || (Life>1)
ignorehitpause=1


[State -2, ]
type = Null;lifeadd
triggerall = stateno = 196
trigger1 = alive
value = 1

[State -2, ]
type = Null;poweradd
triggerall = stateno = 196
trigger1 = alive
value = 1

