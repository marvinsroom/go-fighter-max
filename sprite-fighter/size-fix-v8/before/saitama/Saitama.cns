=====================================
Super Armor
=====================================
[State -2]
Type = Helper
triggerall = command != "hold_start"
triggerall = command != "start"
triggerall = movetype != H
Triggerall = NumHelper(11778) = 0 ; Create the superarmor helper if it doesn't exist.
Trigger1 = Alive
OwnPal = 1
PosType = P1
Pos = 0, 0
ID = 11778
StateNo = 11778
PauseMoveTime = 999999
SuperMoveTime = 999999
Name = "SuperArmor"
ignorehitpause = 1

[State -2, LifeAdd]
Type = Null;LifeAdd
Trigger1 = NumHelper(11778) > 0 ; If the superarmor helper exists, subtract taken damage from life.
Trigger1 = fVar(22) >=1
Value = -floor(fVar(22))
ignorehitpause=1

[State -2, VarSet]
Type = Null;VarAdd
Trigger1 = 1
FV = 22
Value = -floor(fvar(22)) ; Damage already subtracted needs to be removed from the variable
ignorehitpause=1

[State -2]
Type= NotHitBy
triggerall = stateno != 196
triggerall = command != "hold_start"
triggerall = command != "start"
triggerall = movetype != H
Trigger1= NumHelper(11778)>0 ; If the superarmor helper is active, the character cannot be hit by anything.
value=SCA, AA, AT, AP

[State -2]
Type= NotHitBy
triggerall = stateno != 196
triggerall = command != "hold_start"
triggerall = command != "start"
triggerall = movetype != H
Trigger1= NumHelper(11778)>0 ; If the superarmor helper is active, the character cannot be hit by anything.
value2=SCA, AA, AT, AP ; This is for safety, as another Nothitby might override the first one, so better be safe and apply it to both slots.


