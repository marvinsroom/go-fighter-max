;===============================================================================
;----------------------Kage Bunshin no Jutsu------------------------------------
;===============================================================================
; Kage Bunshin - Stand
[Statedef 4000]
type    = S
movetype= I
physics = S
juggle  = 1
velset = 0,0
ctrl = 0
anim = 0+root,var(11)
sprpriority = 0



[State 0, PosSet]
type = PosSet
trigger1 = time = 0
y = 0

[State 0, Turn]
type = Turn
trigger1 = p2bodydist x < -20

[State 200, Walk FWD]
type = ChangeState
trigger1 = p2bodydist x > 30
trigger1 = random < 200
value = 4020

[State 200, Jump]
type = ChangeState
trigger1 = p2bodydist x < 50
trigger1 = p2bodydist y < -30
trigger1 = random < 200
value = 4040

[State 200, Hit 1]
type = ChangeState
trigger1 = p2bodydist x < 100
trigger1 = (p2bodydist x < 100 && p2movetype = A) || (enemy,numproj > 0)
value = 4075

[State 200, Hit 1]
type = ChangeState
trigger1 = p2bodydist x < 50
trigger1 = random < 100
value = 4200

[State 200, Hit 2]
type = ChangeState
trigger1 = p2bodydist x < 50
trigger1 = random < 100
value = 4300

[State 200, Hit 1]
type = ChangeState
triggerall = root,var(2) = 1||root,var(2) = 3||root,var(2) = 4
trigger1 = p2bodydist x < 80
trigger1 = random < 100
value = 4800

[State 200, Hit 2]
type = ChangeState
triggerall = numhelper(4950) = 0
triggerall = root,var(2) >= 5
trigger1 = p2bodydist x > 100
trigger1 = random < 200
value = 4900


[State 200, End]
type = ChangeState
trigger1 = roundstate != 2
value = 4001
