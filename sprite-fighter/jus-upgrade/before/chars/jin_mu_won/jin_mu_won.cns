[Statedef -3]

[State -3, Buffer strike]
type=MapSet
trigger1=!ishelper && time>1 && (stateno=200 || stateno=210 || stateno=220 || stateno=230 || stateno=240 || stateno=250 || stateno=260) && command="a"
map="fighter.buffer"
value=1

[State -3, Buffer strike]
type=MapSet
trigger1=!ishelper && time>1 && (stateno=200 || stateno=210 || stateno=220 || stateno=230 || stateno=240 || stateno=250 || stateno=260) && command="b"
map="fighter.buffer"
value=2

[State -3, Buffer strike]
type=MapSet
trigger1=!ishelper && time>1 && (stateno=200 || stateno=210 || stateno=220 || stateno=230 || stateno=240 || stateno=250 || stateno=260) && command="c"
map="fighter.buffer"
value=3

[State -3, Buffer window]
type=MapSet
trigger1=!ishelper && (command="a" || command="b" || command="c")
map="fighter.buffer_ticks"
value=12

[State -3, Buffer decay]
type=MapAdd
trigger1=!ishelper && map(fighter.buffer_ticks)>0
map="fighter.buffer_ticks"
value=-1

