[State 0, Helper]
type = Helper
triggerall = numhelper(905) = 0
trigger1 = p2stateno = 901
trigger2 = p2stateno = 1002
helpertype = normal ;player
name = "fx"
ID = 905
stateno = 905
pos = -40,-30
ownpal = 1
postype = p2    ;p2,front,back,left,right
facing = -1
size.xscale = .5
size.yscale = .5

;-------------------------------------------------------------------------------
; Sonidos Comunes:
;-------------------------------------------------------------------------------
[State 0, Walk]
type = PlaySnd
triggerall = stateno = 20
trigger1 = animelem = 3
trigger2 = animelem = 6
value = S20,1
volume = 50

[State 0, Run]
type = PlaySnd
triggerall = stateno = 60
trigger1 = animelem = 3 || animelem = 6
value = S20,1
volume = 50

[State 0, Saltando]
type = PlaySnd
triggerall = stateno = 40
trigger1 = Time = 1
value = S40,1
volume = 55
channel = -1

[State 0, Super Jump]
type = PlaySnd
triggerall = stateno = 80
trigger1 = Time = 1
value = S60,1
volume = 55
channel = -1

[State 0, Land]
type = PlaySnd
triggerall = stateno = 52
trigger1 = time = 1
value = S52,1
volume = 50

[State 0, Run FWD]
type = PlaySnd
triggerall = stateno = 60
trigger1 = time = 1
value = S100,0
volume = 50

[State 0, Run FWD]
type = PlaySnd
triggerall = stateno = 70
trigger1 = time = 1
value = S105,0
volume = 50

[State 0, Run FWD]
type = PlaySnd
triggerall = stateno = 75
trigger1 = time = 1
value = S105,0
volume = 50

[State 0, Run FWD]
type = PlaySnd
triggerall = stateno = 76
trigger1 = time = 1
value = S100,0
volume = 50

[State 0, RemoveExplod]
type = RemoveExplod
TRIGGERALL = stateno != 500
trigger1 = time = 1
id = 550

[State 0, StopSnd]
type = StopSnd
TRIGGERALL = stateno != 500
trigger1 = time = 1
channel = 9

[State 0, Golpeado]
type = PlaySnd
trigger1 = movetype=H && (stateno!=[0,155]) && !time && HitOver=0 && random%3=0
value = 5000,ifelse(random < 500,1,ifelse(random < 500,2,3))

[State 0, Solucion Stand Aire]
type = ChangeState
triggerall = stateno = 0||stateno = 20
trigger1 = pos y < 0
value = 50
ctrl = 1

