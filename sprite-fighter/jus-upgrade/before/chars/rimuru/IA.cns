[State -3] ;ults2 2000 power
type = ChangeState
triggerall = ctrl
triggerall = numhelper(1505) = 0
triggerall = StateType = S
triggerall = power>=2000
triggerall = roundstate = 2
Trigger1 = AIlevel > 0
trigger1= random = [201,330]
value = 770

[State -3] ;ults2 1500 power
type = ChangeState
triggerall = ctrl
triggerall = StateType = S
triggerall = power>=1500
triggerall = p2bodydist x < 60
triggerall = roundstate = 2
Trigger1 = AIlevel > 0
trigger1= random = [100,200]
value = 760+(random%2)

[State -3] ;ults1  1000 power
type = ChangeState
triggerall = ctrl
triggerall = StateType = S
triggerall = power>=1000
triggerall = roundstate = 2
triggerall = p2bodydist x < 100
Trigger1 = AIlevel > 0
trigger1= random = [0,80]
value = 750+(random%2)

[State -3]
type = ChangeState
triggerall = StateType = S
triggerall = ctrl
triggerall = numhelper(1505) = 0
triggerall = ailevel > 0 && roundstate = 2
triggerall = power < 3000
triggerall = p2bodydist x > 100
trigger1 = ctrl = 1
value = 500

[State -3]
type = ChangeState
triggerall = ctrl
triggerall = StateType = S
trigger1 = random >500
trigger1 = ailevel = 8
trigger2 = random >200
trigger2 = ailevel = [6,7]
triggerall = roundstate = 2
triggerall = P2bodydist X >= 150
triggerall = ctrl = 1
value = 60

[State -3]
type = ChangeState
triggerall = ctrl
triggerall = Stateno = 50
triggerall = random<=150
triggerall = roundstate = 2
Trigger1 = AIlevel = 8
Trigger2 = AIlevel = [7,6]
Trigger3 = AIlevel = [3,5]
trigger1 = P2bodydist X <= 100 ;&& roundstate = 2;50
trigger2 = P2bodydist X <= 60 ;&& roundstate = 2
trigger3 = P2bodydist X <= 30 ;&& roundstate = 2
triggerall = ctrl = 1
value = 670

[State -3]
type = ChangeState     ;;dodge
triggerall = ctrl
triggerall = StateType = S
triggerall = p2movetype = A
triggerall = p2statetype = S
triggerall = roundstate = 2
Trigger1 = AIlevel = 8
trigger1 = P2bodydist X <= 70 ;&& roundstate = 2;50
triggerall = ctrl = 1
triggerall = random <200
value = 290

[State -3]
type = ChangeState
triggerall = ctrl
triggerall = StateType = S
triggerall = random<=500
triggerall = roundstate = 2
Trigger1 = AIlevel = 8
Trigger2 = AIlevel = [7,6]
Trigger3 = AIlevel = [3,5]
trigger1 = P2bodydist X <= 100 ;&& roundstate = 2;50
trigger2 = P2bodydist X <= 70 ;&& roundstate = 2
trigger3 = P2bodydist X <= 40 ;&& roundstate = 2
triggerall = ctrl = 1
value = 200

